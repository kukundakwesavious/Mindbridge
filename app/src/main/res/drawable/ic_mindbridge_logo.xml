<?xml version="1.0" encoding="utf-8"?>
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:aapt="http://schemas.android.com/aapt"
    android:width="200dp"
    android:height="200dp"
    android:viewportWidth="100"
    android:viewportHeight="100">

    <!-- Soft Ambient Glow -->
    <path
        android:pathData="M50,50m-45,0a45,45 0,1 1,90 0a45,45 0,1 1,-90 0"
        android:fillAlpha="0.08">
        <aapt:attr name="android:fillColor">
            <gradient
                android:centerX="50"
                android:centerY="50"
                android:gradientRadius="45"
                android:type="radial">
                <item android:offset="0.0" android:color="#2563EB" />
                <item android:offset="1.0" android:color="#00FFFFFF" />
            </gradient>
        </aapt:attr>
    </path>

    <!-- Graceful Connecting Bridge Arch -->
    <path
        android:pathData="M15,62 C30,32 70,32 85,62"
        android:strokeWidth="5.5"
        android:strokeLineCap="round">
        <aapt:attr name="android:strokeColor">
            <gradient
                android:startX="15"
                android:startY="45"
                android:endX="85"
                android:endY="62"
                android:type="linear">
                <item android:offset="0.0" android:color="#2563EB" />
                <item android:offset="0.5" android:color="#3B82F6" />
                <item android:offset="1.0" android:color="#10B981" />
            </gradient>
        </aapt:attr>
    </path>

    <!-- Support Pillars representing Stronger Communities -->
    <path
        android:pathData="M32,50 L32,68 M68,50 L68,68"
        android:strokeWidth="2.5"
        android:strokeLineCap="round"
        android:strokeColor="#93C5FD"
        android:strokeAlpha="0.6" />

    <!-- Left Flourishing Leaf representing Healthy Mind -->
    <path
        android:pathData="M50,44 C44,34 34,30 30,36 C26,42 32,52 42,56 C46,58 48,52 50,44 Z"
        android:fillAlpha="0.95">
        <aapt:attr name="android:fillColor">
            <gradient
                android:startX="28"
                android:startY="32"
                android:endX="50"
                android:endY="56"
                android:type="linear">
                <item android:offset="0.0" android:color="#60A5FA" />
                <item android:offset="1.0" android:color="#2563EB" />
            </gradient>
        </aapt:attr>
    </path>

    <!-- Right Flourishing Leaf representing Community Hope -->
    <path
        android:pathData="M50,44 C56,34 66,30 70,36 C74,42 68,52 58,56 C54,58 52,52 50,44 Z"
        android:fillAlpha="0.95">
        <aapt:attr name="android:fillColor">
            <gradient
                android:startX="72"
                android:startY="32"
                android:endX="50"
                android:endY="56"
                android:type="linear">
                <item android:offset="0.0" android:color="#34D399" />
                <item android:offset="1.0" android:color="#059669" />
            </gradient>
        </aapt:attr>
    </path>

    <!-- Central Flame / Rising Sun of Hope -->
    <path
        android:pathData="M50,24 C44,34 44,44 50,54 C56,44 56,34 50,24 Z">
        <aapt:attr name="android:fillColor">
            <gradient
                android:startX="50"
                android:startY="24"
                android:endX="50"
                android:endY="54"
                android:type="linear">
                <item android:offset="0.0" android:color="#FDE68A" />
                <item android:offset="1.0" android:color="#F59E0B" />
            </gradient>
        </aapt:attr>
    </path>

    <!-- Calming Water/Ground Ripple at base -->
    <path
        android:pathData="M25,76 Q50,72 75,76"
        android:strokeWidth="2"
        android:strokeAlpha="0.4"
        android:strokeLineCap="round"
        android:strokeColor="#3B82F6" />

</vector>
