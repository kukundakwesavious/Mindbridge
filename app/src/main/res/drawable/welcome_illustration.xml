<?xml version="1.0" encoding="utf-8"?>
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:aapt="http://schemas.android.com/aapt"
    android:width="300dp"
    android:height="300dp"
    android:viewportWidth="100"
    android:viewportHeight="100">

    <!-- Soft Background Circle -->
    <path
        android:pathData="M50,50m-40,0a40,40 0,1 1,80 0a40,40 0,1 1,-80 0"
        android:fillAlpha="0.05">
        <aapt:attr name="android:fillColor">
            <gradient
                android:centerX="50"
                android:centerY="50"
                android:gradientRadius="40"
                android:type="radial">
                <item android:offset="0.0" android:color="#3B82F6" />
                <item android:offset="1.0" android:color="#00FFFFFF" />
            </gradient>
        </aapt:attr>
    </path>

    <!-- Stylized Person 1 (Calm) -->
    <path
        android:pathData="M35,65 C35,55 45,55 45,65 L45,85 L35,85 Z"
        android:fillColor="#93C5FD" />
    <path
        android:pathData="M40,53m-5,0a5,5 0,1 1,10 0a5,5 0,1 1,-10 0"
        android:fillColor="#60A5FA" />

    <!-- Stylized Person 2 (Supportive) -->
    <path
        android:pathData="M55,65 C55,55 65,55 65,65 L65,85 L55,85 Z"
        android:fillColor="#A7F3D0" />
    <path
        android:pathData="M60,53m-5,0a5,5 0,1 1,10 0a5,5 0,1 1,-10 0"
        android:fillColor="#34D399" />

    <!-- The Bridge/Connection between them -->
    <path
        android:pathData="M45,70 Q50,65 55,70"
        android:strokeWidth="2"
        android:strokeLineCap="round"
        android:strokeColor="#3B82F6" />

    <!-- Floating Heart Symbolizing Welcome -->
    <path
        android:pathData="M50,40 C48,38 42,40 42,46 C42,52 50,58 50,58 C50,58 58,52 58,46 C58,40 52,38 50,40 Z">
        <aapt:attr name="android:fillColor">
            <gradient
                android:startX="42"
                android:startY="38"
                android:endX="58"
                android:endY="58"
                android:type="linear">
                <item android:offset="0.0" android:color="#F87171" />
                <item android:offset="1.0" android:color="#EF4444" />
            </gradient>
        </aapt:attr>
    </path>

    <!-- Decorative Sun/Light Rays -->
    <path
        android:pathData="M20,20 L25,25 M15,35 L22,35 M20,50 L25,45"
        android:strokeWidth="1.5"
        android:strokeLineCap="round"
        android:strokeColor="#FDE68A" />

</vector>
