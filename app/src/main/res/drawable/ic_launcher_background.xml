                android:endX="108"
                android:endY="108"
                android:type="linear">
                <item android:offset="0.0" android:color="#10B981" />
                <item android:offset="1.0" android:color="#0EA5E9" />
            </gradient>
        </aapt:attr>
    </path>

    <!-- Subtle Stardust Sparkles -->
    <path android:pathData="M20,20h1v1h-1z" android:fillColor="#80FFFFFF" />
    <path android:pathData="M80,30h1v1h-1z" android:fillColor="#80FFFFFF" />
