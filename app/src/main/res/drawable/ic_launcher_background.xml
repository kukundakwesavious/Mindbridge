    <!-- Celestial Nebula Glow 1 -->
    <path
        android:pathData="M54,54m-60,0a60,60 0,1 1,120 0a60,60 0,1 1,-120 0"
        android:fillAlpha="0.15">
        <aapt:attr name="android:fillColor">
